<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ComposeEmptyActivity" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash screen shown while the process cold-starts, before MainActivity's
         Compose content is ready. Uses androidx Core SplashScreen (UI-only), then
         hands off to Theme.ComposeEmptyActivity. -->
    <style name="Theme.Zurutial.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#7A4FE0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.ComposeEmptyActivity</item>
    </style>
</resources>